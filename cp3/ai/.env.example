# Sem chave, a aplicação usa extração local demonstrativa, sem LLM.
OPENROUTER_API_KEY=
# IDs configuráveis: confirme disponibilidade no catálogo do OpenRouter.
MODEL_FAST=google/gemini-2.5-flash
MODEL_DEEP=anthropic/claude-sonnet-4.5
MODEL_FALLBACK=openai/gpt-4.1-mini
# Limite conservador compartilhado: deve caber no menor modelo configurado.
MODEL_CONTEXT_WINDOW=16384
INPUT_TOKEN_BUDGET=6000
OUTPUT_TOKEN_BUDGET=1000
DATA_DIR=data
